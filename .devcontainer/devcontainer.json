{
  "name": "mangrovebackreef",
  "build": { "dockerfile": "Dockerfile" },
  "containerUser": "root",
  "remoteUser": "root",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/rstudio-server": {},
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli": { "version": "1.10.19" }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postAttachCommand": {
    "rstudio-start": "rserver"
  },
  "forwardPorts": [8787, 4200],
  "portsAttributes": {
    "8787": { "label": "RStudio IDE" },
    "4200": { "label": "Quarto preview" }
  },
  "customizations": {
    "vscode": { "extensions": ["REditorSupport.r", "quarto.quarto"] }
  }
}
